  "thresholds": {
    "complete_miss": {
      "jsonl": "point-lookup-directory.jsonl",
      "record": "point_lookup_directory::complete_miss_opens_zero_readers",
      "expect": 0,
      "status_key": "complete_miss_ok",
      "description": "Opened-reader delta for a complete directory miss must be exactly 0 (spec \u00a713.7), read from the JSON emission, never from a grep of cargo output."
    },
    "point_lookup_p95_ratio": {
      "jsonl": "point-lookup-runs.jsonl",
      "record": "point_lookup_scaling_256_to_1",
      "baseline_target_runs": 1,
      "comparison_target_runs": 256,
      "max_ratio_env": "POINT_LOOKUP_MAX_P95_RATIO",
      "default_max_ratio": 1.4,
      "status_key": "point_lookup_p95_ratio_ok",
      "label_key": "point_lookup_256_to_1_p95_ratio",
      "description": "p95(256 runs) / p95(1 run) must be <= the threshold (spec \u00a713.9). Fails closed when either sample is absent; no jq // defaults may mask missing data. The exact threshold used is recorded in closure-status.json."
    },
    "ann_hnsw_dense_verdict": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::ann_hnsw_dense",
      "status_key": "ann_hnsw_dense_verdict_ok",
      "description": "ANN HNSW Dense verdict must pass with recall >= required_recall and ineligible_hits == 0 (B468-07).",
      "jq": "(.[] | select(.test==\"index_churn_oracle::verdict::ann_hnsw_dense\") | .metric | (.status == \"pass\" and .ineligible_hits == 0 and (.recall // 1) >= .required_recall))"
    },
    "exact_family_verdicts": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::fm",
      "status_key": "exact_family_verdicts_ok",
      "description": "Exact family verdicts must report membership/ordering/score equality (B468-07).",
      "jq": "all(.[] | select(.test|startswith(\"index_churn_oracle::verdict::\")); (.metric.status == \"pass\"))"
    },
    "p0p2_all_verdicts_pass": {
      "jsonl": "p0p2-threshold-verdict.jsonl",
      "status_key": "p0p2_thresholds_ok",
      "description": "B468-10: every multi-rep P0/P2 threshold verdict must have status=pass (5-rep medians).",
      "jq": "all(.[]; .metric.status == \"pass\")",
      "label": "p0p2 multi-rep thresholds pass"
    },
    "p0p2_repetition_count": {
      "jsonl": "p0p2-threshold-verdict.jsonl",
      "record": "p0p2::threshold::repetition_count",
      "status_key": "p0p2_reps_ok",
      "description": "B468-10: p0/p2 harvest must record required_reps (default 5).",
      "jq": "any(.[]; .test==\"p0p2::threshold::repetition_count\" and .metric.status==\"pass\" and (.metric.required_reps // 0) >= 5)",
      "label": "p0p2 five-rep completeness"
    },
    "sparse_tie_break": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::sparse_tie_break",
      "jq": "any(.[]; .test==\"index_churn_oracle::sparse_tie_break\" and .metric.status==\"pass\" and .metric.ordering_equal==true)",
      "label": "Sparse equal-score ascending RowId tie-break"
    },
    "verdict_ann_hnsw_dense_measured": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::ann_hnsw_dense",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::ann_hnsw_dense\" and .metric.status==\"pass\" and (.metric.checkpoints // 0) > 0 and ((.metric.minimum_recall // .metric.recall // 0) >= (.metric.required_recall // 0.9)) and (.metric.unexpected_underfills // 0) == 0 and .metric.final_model_equal==true)",
      "label": "ann_hnsw_dense measured verdict"
    },
    "verdict_ann_hnsw_binary_sign_measured": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::ann_hnsw_binary_sign",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::ann_hnsw_binary_sign\" and .metric.status==\"pass\" and (.metric.checkpoints // 0) > 0 and ((.metric.minimum_recall // .metric.recall // 0) >= (.metric.required_recall // 0.95)) and (.metric.unexpected_underfills // 0) == 0 and .metric.final_model_equal==true)",
      "label": "ann_hnsw_binary_sign measured verdict"
    },
    "verdict_ann_product_quantization_measured": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::ann_product_quantization",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::ann_product_quantization\" and .metric.status==\"pass\" and (.metric.checkpoints // 0) > 0 and ((.metric.minimum_recall // .metric.recall // 0) >= (.metric.required_recall // 0.8)) and (.metric.unexpected_underfills // 0) == 0 and .metric.final_model_equal==true)",
      "label": "ann_product_quantization measured verdict"
    },
    "verdict_ann_diskann_dense_measured": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::ann_diskann_dense",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::ann_diskann_dense\" and .metric.status==\"pass\" and (.metric.checkpoints // 0) > 0 and ((.metric.minimum_recall // .metric.recall // 0) >= (.metric.required_recall // 0.9)) and (.metric.unexpected_underfills // 0) == 0 and .metric.final_model_equal==true)",
      "label": "ann_diskann_dense measured verdict"
    },
    "verdict_ann_ivf_dense_measured": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::ann_ivf_dense",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::ann_ivf_dense\" and .metric.status==\"pass\" and (.metric.checkpoints // 0) > 0 and ((.metric.minimum_recall // .metric.recall // 0) >= (.metric.required_recall // 0.85)) and (.metric.unexpected_underfills // 0) == 0 and .metric.final_model_equal==true)",
      "label": "ann_ivf_dense measured verdict"
    },
    "verdict_minhash_measured": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::minhash",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::minhash\" and .metric.status==\"pass\" and (.metric.checkpoints // 0) > 0 and ((.metric.minimum_recall // .metric.recall // 0) >= (.metric.required_recall // 0.8)) and (.metric.unexpected_underfills // 0) == 0 and .metric.final_model_equal==true)",
      "label": "minhash measured verdict"
    },
    "verdict_fm_exact": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::fm",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::fm\" and .metric.status==\"pass\" and .metric.membership_equal==true and .metric.final_model_equal==true and (.metric.unexpected_underfills // 0)==0)",
      "label": "fm exact verdict"
    },
    "verdict_learned_range_exact": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::learned_range",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::learned_range\" and .metric.status==\"pass\" and .metric.membership_equal==true and .metric.final_model_equal==true and (.metric.unexpected_underfills // 0)==0)",
      "label": "learned_range exact verdict"
    },
    "verdict_sparse_exact": {
      "jsonl": "churn-oracle.jsonl",
      "record": "index_churn_oracle::verdict::sparse",
      "jq": "any(.[]; .test==\"index_churn_oracle::verdict::sparse\" and .metric.status==\"pass\" and .metric.membership_equal==true and .metric.final_model_equal==true and (.metric.unexpected_underfills // 0)==0)",
      "label": "sparse exact verdict"
    }
  },
