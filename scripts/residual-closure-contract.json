        "ann_candidate_eligibility_uses_hlc_winner_across_runs",
        "ttl_inverted_run_is_admitted_via_values_for_rids_at",
        "hot_candidate_inspection_uses_full_snapshot_for_run_versions",
        "learned_range_rebuild_indexes_only_hlc_visible_winners",
        "rebuild_indexes_uses_global_hlc_winners_not_run_iteration_order",
        "version_stamp_is_newer_than_matches_snapshot_rule"
